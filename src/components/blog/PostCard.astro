---
import { getFeaturedImage, formatDate } from '../../utils/content.js';

interface Props {
  post: any;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const image = getFeaturedImage(post);
const cleanTitle = post.title?.rendered || '';
const rawExcerpt = post.excerpt?.rendered || '';
const cleanExcerpt = rawExcerpt.replace(/<[^>]+>/g, '').replace(/\[&hellip;\]/g, '...').trim();
const displayDate = formatDate(post.date);
const postUrl = `/${post.slug}/`;

// Category detection
const isDuvida = post.categories?.includes(21);
const categoryLabel = isDuvida ? '💡 Guia prático' : '🏆 Ranking 2026';
const categoryClass = isDuvida ? 'badge-duvida' : 'badge-ranking';

// Reading time estimate (approx 220 words per minute)
const wordCount = (post.content?.rendered || '').split(/\s+/).length;
const readTime = Math.max(3, Math.ceil(wordCount / 220));

// Editorial score calculation for ranking posts (consistent mock between 9.2 and 9.8)
const scoreSeed = (post.id % 7);
const editorialScore = (9.2 + scoreSeed * 0.1).toFixed(1);
---

<article class={`post-card-modern ${featured ? 'post-card-featured' : ''}`}>
  <div class="post-card-thumb-wrap">
    <a href={postUrl} title={cleanTitle} class="post-card-thumb-link" tabindex="-1" aria-hidden="true">
      <img
        src={image.url}
        alt={image.alt || cleanTitle}
        class="post-card-thumb"
        loading="lazy"
        decoding="async"
        width={image.width || 600}
        height={image.height || 400}
        onerror="this.src='/wp-content/uploads/2024/12/Icone-de-fone-de-ouvido.webp'"
      />
      <div class="post-card-gradient-overlay"></div>
    </a>

    <div class="post-card-badges-row">
      <span class={`post-card-badge ${categoryClass}`}>{categoryLabel}</span>
      {!isDuvida && (
        <span class="post-card-rating">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>{editorialScore}</span>
        </span>
      )}
    </div>
  </div>

  <div class="post-card-body">
    <div class="post-card-meta">
      <div class="post-card-author-mini">
        <img
          src="https://secure.gravatar.com/avatar/911d262c03578ea2cd44946c0fcbd8b37e483b30c876a28b699d8ef741511314?s=48&d=mm&r=g"
          alt="Bianca Haru"
          class="author-mini-img"
          width="20"
          height="20"
          loading="lazy"
        />
        <span>Bianca Haru</span>
      </div>
      <span class="meta-separator">&bull;</span>
      <time datetime={post.date}>{displayDate}</time>
      <span class="meta-separator">&bull;</span>
      <span>{readTime} min</span>
    </div>

    <h3 class="post-card-title">
      <a href={postUrl} set:html={cleanTitle} />
    </h3>

    <p class="post-card-excerpt">
      {cleanExcerpt.length > 115 ? `${cleanExcerpt.slice(0, 115)}...` : cleanExcerpt}
    </p>

    <div class="post-card-footer">
      <span class="tested-stamp">✓ Testado</span>
    </div>
  </div>
</article>
