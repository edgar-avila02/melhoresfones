---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  type?: 'website' | 'article';
  image?: {
    url: string;
    width?: number;
    height?: number;
    alt?: string;
  };
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title,
  description = "Avaliações detalhadas para você encontrar o fone ideal.",
  canonical,
  type = 'website',
  image = {
    url: "https://melhoresfones.com/wp-content/uploads/2024/03/Logo-do-melhores-fones.webp",
    width: 300,
    height: 300,
    alt: "Logo do melhores fones"
  },
  publishedTime,
  modifiedTime,
  author = "Bianca Haru"
} = Astro.props;

const siteUrl = "https://melhoresfones.com";
let currentPath = Astro.url.pathname;
if (!currentPath.endsWith('/')) {
  currentPath += '/';
}
const canonicalUrl = canonical || `${siteUrl}${currentPath}`;
const formattedTitle = (type === 'article' || title.toLowerCase().includes("melhores fones"))
  ? title
  : `${title} - Melhores fones`;
const fullImageUrl = (image.url || '').startsWith('http') ? image.url : `${siteUrl}${image.url}`;

// Schema.org Graph
const schemaGraph: any[] = [
  {
    "@type": ["Person", "Organization"],
    "@id": `${siteUrl}/#person`,
    "name": "Melhores Fones",
    "logo": {
      "@type": "ImageObject",
      "@id": `${siteUrl}/#logo`,
      "url": "https://melhoresfones.com/wp-content/uploads/2024/03/cropped-Logo-do-melhores-fones-2.webp",
      "contentUrl": "https://melhoresfones.com/wp-content/uploads/2024/03/cropped-Logo-do-melhores-fones-2.webp",
      "caption": "Melhores Fones",
      "inLanguage": "pt-BR"
    }
  },
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "url": siteUrl,
    "name": "Melhores Fones",
    "inLanguage": "pt-BR",
    "publisher": { "@id": `${siteUrl}/#person` }
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    "url": canonicalUrl,
    "name": formattedTitle,
    "isPartOf": { "@id": `${siteUrl}/#website` },
    "inLanguage": "pt-BR"
  }
];

if (type === 'article') {
  schemaGraph.push({
    "@type": "Article",
    "@id": `${canonicalUrl}#article`,
    "isPartOf": { "@id": `${canonicalUrl}#webpage` },
    "headline": title,
    "description": description,
    "datePublished": publishedTime || "2024-03-23T21:15:16-03:00",
    "dateModified": modifiedTime || publishedTime || "2026-01-09T18:58:45-03:00",
    "mainEntityOfPage": { "@id": `${canonicalUrl}#webpage` },
    "publisher": { "@id": `${siteUrl}/#person` },
    "author": {
      "@type": "Person",
      "name": author,
      "url": "https://melhoresfones.com/time-melhores-fones/"
    },
    "image": {
      "@type": "ImageObject",
      "url": fullImageUrl,
      "width": image.width || 1200,
      "height": image.height || 800
    },
    "inLanguage": "pt-BR"
  });
}
---

<!-- Essential Meta Tags -->
<title>{formattedTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={canonicalUrl} />
<meta name="google-site-verification" content="UURr6MrCy30ZBSBhz-Bf5aQxdfe5RuXO1PdtnMNfRto" />

<!-- Open Graph / Facebook -->
<meta property="og:locale" content="pt_BR" />
<meta property="og:type" content={type} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Melhores Fones" />
<meta property="og:image" content={fullImageUrl} />
{image.width && <meta property="og:image:width" content={String(image.width)} />}
{image.height && <meta property="og:image:height" content={String(image.height)} />}
{image.alt && <meta property="og:image:alt" content={image.alt} />}

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{type === 'article' && <meta property="article:author" content={author} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />

<!-- Favicons & App Icons -->
<link rel="icon" href="/wp-content/uploads/2023/05/cropped-Melhores-fones-favicon-32x32.webp" sizes="32x32" />
<link rel="icon" href="/wp-content/uploads/2023/05/cropped-Melhores-fones-favicon-192x192.webp" sizes="192x192" />
<link rel="apple-touch-icon" href="/wp-content/uploads/2023/05/cropped-Melhores-fones-favicon-180x180.webp" />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": schemaGraph })} />
