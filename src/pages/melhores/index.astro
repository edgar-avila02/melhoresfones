---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getPosts } from '../../utils/content.js';

const categoryPosts = getPosts().filter((p: any) => p.categories?.includes(31));
---

<BaseLayout
  title="Melhores fones de ouvido - Rankings e testes 2026"
  description="Bem-vindo à categoria Melhores! Nosso time de especialistas selecionou os melhores fones de ouvido para ajudá-lo a encontrar o modelo ideal."
  canonical="https://melhoresfones.com/melhores/"
>
  <div class="site-container" style="padding-top: 4rem; padding-bottom: 6rem;">
    <header class="section-header-modern" style="margin-bottom: 3.5rem;">
      <nav class="breadcrumbs" style="justify-content: center; margin-bottom: 1.25rem;">
        <a href="/">Início</a>
        <span>&rsaquo;</span>
        <span aria-current="page">Melhores</span>
      </nav>
      <span class="section-tag">Rankings 2026</span>
      <h1 class="section-title-modern">Os melhores fones de ouvido</h1>
      <p class="section-desc-modern">
        Nosso <a href="/time-melhores-fones/" style="color: var(--color-primary); font-weight: 700; text-decoration: underline;">time de especialistas</a> testou centenas de modelos para selecionar os melhores fones em custo-benefício, conforto e qualidade sonora.
      </p>
    </header>

    <div class="posts-grid">
      {categoryPosts.map((post: any) => (
        <PostCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
